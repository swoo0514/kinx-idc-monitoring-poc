[Unit]
# 게이트웨이는 알림 분석·조치 후보 등록·리포트 승인·질의가 모두 지나는 자리다.
# 기동이 nohup 한 줄이면 죽었을 때 아무도 살리지 않는다(2026-08-19 점검 E-8).
Description=KINX 관제 게이트웨이 (알림 분석·질의)
Documentation=file:///opt/kinx/bot/GATEWAY_GUIDE.md
After=network-online.target
Wants=network-online.target

# 5분에 다섯 번을 넘겨 죽으면 그만 살린다. 무한 재기동은 원인을 가린다.
# **[Unit] 절에 적는다.** [Service] 에 적으면 systemd 가 무시해서, 실제로 초당 한 번씩
# 12,000번 넘게 되살아났다(2026-08-19 랩 실측).
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=exec
User=rocky
Group=rocky
WorkingDirectory=%h/kinx-idc-monitoring-poc/bot

# **설정 파일은 systemd 가 아니라 우리가 읽는다.** `EnvironmentFile` 로 걸면 systemd(root)
# 가 읽는데, SELinux 가 켜진 곳에서는 홈 아래 파일(`user_home_t`)을 읽지 못해 기동이
# 통째로 막힌다(2026-08-19 랩 실측: Failed to load environment files: Permission denied).
# 셸이 사용자 권한으로 읽으면 그 문제가 없고, 설정 파일이 한 곳으로 유지된다.
ExecStart=/bin/bash -c 'set -a; . ./.env; set +a; exec %h/bot-venv/bin/python -m uvicorn gateway.app:app --host 0.0.0.0 --port 8800'

# 워커를 늘리지 않는다. 워커마다 인시던트 버퍼와 세션 표가 따로 생겨 부모 카드가
# 여러 개 뜬다. 다중화하려면 그 두 상태를 먼저 Redis 로 옮겨야 한다.

# 정상 종료 때 대기 중인 사건을 마감할 시간을 준다(가이드 §8-6).
KillSignal=SIGTERM
TimeoutStopSec=30

Restart=always
RestartSec=5

# 로그는 저널로 보낸다. /tmp 에 회전 없이 쌓이던 것을 옮긴 것이다 — 그 파일에는
# 실 호스트명이 남고 같은 기계의 다른 사용자가 읽을 수 있었다(2026-08-19 점검 E-10).
StandardOutput=journal
StandardError=journal
SyslogIdentifier=kinx-gateway

# 이 프로세스가 건드릴 곳을 좁힌다. 저장소와 대기 파일은 홈 아래에 있다.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=false

[Install]
WantedBy=multi-user.target
