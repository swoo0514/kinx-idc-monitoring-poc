# bot/.env.example — 이 파일을 복사해 bot/.env 로 만들고 값을 채운다.
#   cp bot/.env.example bot/.env
#   set -a; source bot/.env; set +a       # 게이트웨이 기동 전 반드시 source
# .env 는 .gitignore 로 커밋 금지됨(크리덴셜). .env.example 만 커밋한다.
#
# 이 파일이 환경변수 "목록"의 owner 이고, 각 변수를 왜 그렇게 정했는지의 근거는
# bot/GATEWAY_GUIDE.md 에 있다. 새 변수를 코드에 추가하면 여기에도 추가한다.
#
# ⚠ .env 를 고친 뒤 다시 source 하지 않으면 옛 값이 그대로 살아 있다. 프로세스를
#   죽였다 다시 띄운다 — 랩에서 LLM 타임아웃이 안 먹은 원인이 이것이었다.
#
# 표기: [필수] 없으면 동작 자체가 안 됨 / [선택] 없으면 그 기능만 열화(전체는 계속 돎)


# ── 1. 필수 ────────────────────────────────────────────────────────────
# 웹훅 인증 토큰. Zabbix 미디어타입·Wazuh integration 이 같은 값을 보낸다.
# [필수] 비어 있으면 인증이 성립하지 않는다.
GATEWAY_TOKEN=lab_change_me_gateway

# Zabbix API. 토큰은 **읽기 전용 계정**으로 발급한다(코드가 .get 외 호출을 거부한다).
# [필수] 없으면 컨텍스트 수집이 통째로 비고 트리아지가 무의미해진다.
# 주소는 **base 까지만** 적는다 — 코드가 /api_jsonrpc.php 를 붙인다.
# 예시에 경로까지 넣어 뒀다가 그대로 복사되면 경로가 두 번 붙어 연결이 실패한다(실측 2026-08-10).
ZABBIX_URL=http://192.0.2.26:8080
ZABBIX_TOKEN=lab_change_me_zbx_token


# ── 2. LLM (분석 계층) ─────────────────────────────────────────────────
# [선택] 없으면 **열화 모드** — 선판정·병합 결과만 회신하고 인과 설명이 빠진다.
#        데모는 죽지 않지만 하이라이트가 사라진다.
ANTHROPIC_API_KEY=
LLM_CLAUDE_MODEL=claude-opus-4-8
# 초. 랩 실측 총 시간 중앙값 14.1초 기준으로 여유를 둔 값. 인시던트 컨텍스트가
# 커지면 늘려야 한다(병합 알림이 많을수록 프롬프트가 길어진다).
LLM_TIMEOUT_S=45

# 폴백 경로. Claude 실패 시 여기로 넘어가고, 이것도 없으면 열화 모드.
# [선택] 온프렘 요건이 없다면 비워 둬도 된다.
OLLAMA_URL=
OLLAMA_MODEL=qwen3:8b


# ── 3. Slack (회신 계층) ───────────────────────────────────────────────
# [선택] 없으면 분석은 돌지만 어디에도 안 보인다. 스코프는 chat:write 하나면 된다.
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=
# 낮은 심각도·만성 건을 따로 모으는 채널. 없으면 전부 위 채널로 간다.
SLACK_CHANNEL_ID_DIGEST=


# ── 4. 관측 소스 (교차 신호) ───────────────────────────────────────────
# 없으면 그 축이 "조회 실패"가 아니라 **"비활성"**으로 기록된다. 이 구분이 중요하다 —
# 조회 실패를 "신호 없음"으로 읽으면 봇이 "침해 흔적 없음"을 잘못 단언한다.
# [선택] 하나도 없으면 Zabbix 단일 축 트리아지가 된다.
LOKI_URL=http://192.0.2.26:3100
WAZUH_INDEXER_URL=https://192.0.2.5:9200
WAZUH_INDEXER_USER=readall
WAZUH_INDEXER_PASSWORD=

# Zabbix 호스트명 → Loki/Wazuh 의 FQDN 번역. Ansible 로 배포한 호스트는 세 에이전트가
# 같은 이름을 쓰므로 **불필요**하고, 손으로 설치한 호스트만 여기에 적는다.
# 형식: zabbix명=FQDN,zabbix명2=FQDN2
# [선택] 이름이 어긋난 호스트에서 매핑이 없으면 로그·보안 조회가 0건으로 돌아온다.
HOST_LABEL_MAP=


# ── 5. Keep (알림 저장·승인 UI) ────────────────────────────────────────
# [선택] 없으면 Slack 으로만 나가고 승인 큐(데모 B)가 성립하지 않는다.
KEEP_URL=http://192.0.2.35:8080
KEEP_API_KEY=


# ── 6. HolmesGPT (심층 조사) ───────────────────────────────────────────
# 실시간 트리아지와 별개의 온디맨드 조사 경로. 기본은 꺼져 있다.
# [선택] HOLMES_ENABLED 가 "1" 이 아니면 전부 무시된다.
HOLMES_ENABLED=0
HOLMES_URL=
HOLMES_API_KEY=
HOLMES_MODEL=
# 마스킹을 통과시킬지. 끄면 원문이 그대로 나간다 — MSP 대상에는 반드시 1.
HOLMES_MASKED=1
# 초. 에이전틱이라 수십 콜을 돌아 실시간 예산(30초)에 안 맞는다. 그래서 별도 경로다.
HOLMES_TIMEOUT_S=300


# ── 7. 판정 파라미터 (바꾸면 판정 기준이 바뀐다) ───────────────────────
# 만성/신규 선판정 — 며칠을 보고, 몇 회 이상이면 만성으로 볼 것인가.
PREJUDGE_WINDOW_DAYS=90
PREJUDGE_CHRONIC_MIN=5

# 인시던트 병합 창.
#   DEBOUNCE_S          마지막 알림 뒤 이만큼 조용하면 창을 닫는다
#   MAX_WINDOW_S        아무리 알림이 이어져도 이 시점엔 닫는다
#   PRIORITY_DEBOUNCE_S SEV1 은 기다리지 않고 이만큼만에 닫는다
#   MAX_ALERTS          한 사건에 담는 알림 상한(프롬프트 폭주 방지)
#   GATE_MIN_CROSS      분석을 발동시키는 최소 교차 신호 수
# ⚠ 시연에서 대기 체감을 줄이려고 DEBOUNCE_S 를 낮추면, 늦게 오는 알림이 별개 사건으로
#   갈라진다. "알림이 따로 뜬다"의 흔한 원인이다.
INCIDENT_DEBOUNCE_S=90
INCIDENT_MAX_WINDOW_S=300
INCIDENT_PRIORITY_DEBOUNCE_S=15
INCIDENT_MAX_ALERTS=20
INCIDENT_GATE_MIN_CROSS=1


# ── 8. Slack 카드의 Grafana 딥링크 ─────────────────────────────────────
# [선택] 없으면 카드에 링크가 안 붙는다. **사람이 클릭할 주소**이므로 브라우저에서
#        닿는 주소를 넣는다(내부 주소를 넣으면 링크가 죽는다).
GRAFANA_URL=http://192.0.2.26:3000
GRAFANA_DASHBOARD=kinx-overview


# ── 9. MSP 월간 리포트 (bot/msp_report.py · bot/report_deliver.py) ─────
# 게이트웨이 본체와 무관하다. 리포트를 안 쓰면 이 절 전체를 비워도 된다.

# 집계값을 Zabbix trapper 아이템으로 보낼 때 쓴다.
ZBX_TRAPPER_HOST=192.0.2.26
ZBX_TRAPPER_PORT=10051

# 초안·산출물 저장 위치. 산출물에는 고객 데이터가 담기므로 **커밋되지 않는 곳**에 둔다.
REPORT_DRAFT_DIR=~/.kinx-report-drafts
REPORT_OUT_DIR=../private/report

# 발송.
REPORT_FROM=
REPORT_TO=
SMTP_HOST=192.0.2.26
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=0

# Grafana 렌더. **주소를 둘로 나눈다** — 렌더러는 서버 안에서 접속하므로 내부 주소,
# 메일 본문의 링크는 사람이 클릭하므로 공인 주소를 쓴다. 하나로 합치면 서버가
# 자기 공인 IP 로 자기에게 접속하려다 멈춘다(랩에서 실제로 겪음).
GRAFANA_INTERNAL_URL=http://localhost:3000
GRAFANA_RENDER_URL=
# 인증은 토큰 우선, 없으면 계정.
GRAFANA_TOKEN=
GRAFANA_USER=admin
GRAFANA_PASSWORD=
