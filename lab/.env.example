# lab/.env.example — 이 파일을 복사해 lab/.env 로 만들고 값을 채운다.
#   cp lab/.env.example lab/.env
# .env 는 .gitignore 로 커밋 금지됨(크리덴셜). .env.example 만 커밋한다.
# 값은 랩 전용 임의 비밀번호. 실환경 크리덴셜을 절대 넣지 말 것.

# MariaDB
MYSQL_ROOT_PASSWORD=lab_change_me_root
MYSQL_DATABASE=zabbix
MYSQL_USER=zabbix
MYSQL_PASSWORD=lab_change_me_zbx

# MariaDB 복제 (--profile ha 에서만 사용. setup-slave.sh 가 이 계정을 마스터에 생성)
REPLICATION_USER=repl
REPLICATION_PASSWORD=lab_change_me_repl

# 데모 C: vm-target-002(별도 VM) 슬레이브가 복제로 붙을 때만 사용.
# master 3306 을 이 인터페이스에만 노출 — 반드시 사설 IP(예: 192.0.2.10). 공인 IP 절대 금지.
# 비워두면 기본 127.0.0.1(비노출). 절차는 lab/mariadb/REPL_VM_GUIDE.md
MASTER_BIND_IP=127.0.0.1
# 데모 C 복제 대상 DB(작게 유지 — zabbix DB 전체 복제 금지). demo 쓰기 계정도 함께 생성됨
DEMO_REPL_DB=demo_repl
DEMO_WRITER_USER=demowriter
DEMO_WRITER_PASSWORD=lab_change_me_demow

# Grafana (admin 계정 비밀번호. 로그인 ID 는 admin)
GRAFANA_ADMIN_PASSWORD=lab_change_me_grafana

# Grafana 데이터소스 크리덴셜 ($ 문자는 provisioning 에서 변수로 처리되니 비번에 넣지 말 것)
# Zabbix: Zabbix UI 에서 만든 읽기 전용 계정
ZBX_GRAFANA_USER=grafana-ro
ZBX_GRAFANA_PASSWORD=lab_change_me_zbxro
# Wazuh Indexer: 사설 IP 붙는 IXcloud VM 에서만 값 채움 (로컬은 비워두면 데이터소스만 등록)
WAZUH_INDEXER_URL=https://<INDEXER_IP>:9200
WAZUH_INDEXER_USER=readall
WAZUH_INDEXER_PASSWORD=lab_change_me_wazuhro
